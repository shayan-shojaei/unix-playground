{
  "t1-grep-1": "grep 404 access.log",
  "t1-grep-2": "grep -c 200 access.log",
  "t1-grep-3": "grep -v 200 access.log",
  "t1-pipe-wc-1": "grep 200 access.log | wc -l",
  "t1-pipe-wc-2": "cat access.log | wc -l",
  "t1-awk-1": "awk '{print $1}' access.log",
  "t1-awk-2": "awk '{print $3}' access.log",
  "t1-awk-3": "awk '{print $1, $3}' access.log",
  "t1-awk-4": "awk '/404/{print $3}' access.log",
  "t1-sort-1": "awk '{print $1}' access.log | sort",
  "t1-sort-2": "awk '{print $1}' access.log | sort -r",
  "t1-sort-3": "awk '{print $1}' access.log | sort -u",
  "t1-uniq-1": "awk '{print $1}' access.log | sort | uniq",
  "t1-uniq-2": "awk '{print $1}' access.log | sort | uniq -c",
  "t1-uniq-3": "awk '{print $1}' access.log | sort | uniq -c | sort -n",
  "t1-sed-1": "sed 's/s/S/' access.log",
  "t1-sed-2": "sed 's/s/S/g' access.log",
  "t1-sed-3": "sed -e 's/,/ /' -e 's/admin/ADMIN/' users.csv",
  "t1-sed-4": "sed '1d' users.csv",
  "t1-cut-1": "cut -d, -f2 users.csv",
  "t1-cut-2": "cut -d, -f3 users.csv",
  "t1-redirect-1": "grep admin users.csv > admins.csv",
  "t1-redirect-2": "grep grace users.csv >> admins.csv",
  "t1-tr-1": "cat access.log | tr o 0",
  "t1-tr-2": "cat access.log | tr -d 0123456789",
  "t1-tr-3": "cut -d, -f3 users.csv | tr a @",
  "t1-tr-4": "grep 404 access.log | tr 4 X",
  "t1-printf-1": "printf '%s\\n%s' ada admin",
  "t1-printf-2": "printf '%s: %d' count 3",
  "t1-diff-1": "diff roster.csv roster-v2.csv",
  "t1-diff-2": "diff roster.csv roster-v3.csv",
  "t1-diff-3": "diff roster.csv roster-v4.csv",
  "t1-diff-4": "diff roster-v4.csv roster.csv",
  "t1-tee-1": "grep admin users.csv | tee admins-new.csv",
  "t1-tee-2": "grep grace users.csv | tee -a admins.csv",
  "t1-tee-3": "cat access.log | tee full.log | wc -l",
  "t1-tee-4": "grep 200 access.log | tee matched.log | wc -l",
  "t1-xargs-1": "echo ada grace alan | xargs echo user:",
  "t1-xargs-2": "cut -d, -f1 users.csv | xargs echo id:",
  "t1-xargs-3": "awk '{print $1}' access.log | sort -u | xargs echo status:",
  "t1-xargs-4": "grep 404 access.log | awk '{print $2}' | xargs echo method:"
}
