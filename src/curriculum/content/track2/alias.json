{
  "concept": "aliases",
  "track": 2,
  "guide": {
    "concept": "aliases",
    "description": "alias name=command defines a shortcut: from then on, typing name behaves as if you'd typed the full command. It's how people compress a long or frequently-typed command down to a couple of characters.",
    "syntax": "alias name=command",
    "flags": [],
    "examples": [
      { "cmd": "alias ll=ls", "output": "(no output)", "note": "defines 'll' as a shortcut for 'ls'" },
      { "cmd": "alias", "output": "alias ll='ls'", "note": "with no arguments, alias lists everything you've defined" }
    ]
  },
  "exercises": [
    {
      "id": "t2-alias-1",
      "title": "Define an alias",
      "task": "Define an alias called 'll' for 'ls'.",
      "startFs": {
        "report.txt": { "content": "line one\nline two\nline three" },
        "report.csv": { "content": "id,amount\n1,100\n2,250" },
        "notes.md": { "content": "meeting notes" },
        "build.sh": { "content": "#!/bin/sh\necho building" }
      },
      "startCwd": [],
      "hints": ["alias <name>=<command>", "Try: alias ll=ls"],
      "criteria": [{ "id": "ll", "label": "ll is aliased to ls", "check": { "type": "state", "predicate": "aliasEquals", "name": "ll", "value": "ls" } }]
    },
    {
      "id": "t2-alias-2",
      "title": "Define another alias",
      "task": "Now define an alias called 'h' for 'history'.",
      "startFs": {
        "report.txt": { "content": "line one\nline two\nline three" },
        "report.csv": { "content": "id,amount\n1,100\n2,250" },
        "notes.md": { "content": "meeting notes" },
        "build.sh": { "content": "#!/bin/sh\necho building" }
      },
      "startCwd": [],
      "hints": ["Same syntax, a different name and command", "Try: alias h=history"],
      "criteria": [{ "id": "h", "label": "h is aliased to history", "check": { "type": "state", "predicate": "aliasEquals", "name": "h", "value": "history" } }]
    }
  ]
}
